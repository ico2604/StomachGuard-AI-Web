# ====================================================================
# Backend 환경 변수 (.env)
# ====================================================================
# 사용 방법:
#   cp .env.example .env
#   # SECRET_KEY, ENCRYPTION_KEY 를 실제 랜덤 값으로 변경
# ====================================================================

# ------ 데이터베이스 ------
# MySQL (로컬 개발):
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/gastric_hospital
# PostgreSQL (Docker):
# DATABASE_URL=postgresql+psycopg2://gastric:gastric_secret@localhost:5432/gastric_hospital

# ------ JWT (필수 - 변경 필요!) ------
# 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-THIS-generate-with-python-secrets-token-urlsafe-48-minimum-32-chars

# ------ 암호화 (필수 - 변경 필요!) ------
# 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=CHANGE-THIS-generate-with-python-secrets-token-urlsafe-32-min32chars

# ------ JWT 설정 ------
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------ 서버 ------
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# ------ CORS ------
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
# 또는 BACKEND_CORS_ORIGINS 도 지원:
# BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------ Redis / Celery ------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ------ Dynamic Batching ------
BATCH_SIZE=8
BATCH_TIMEOUT_MS=100

# ------ Celery Worker ------
CELERY_WORKER_CONCURRENCY=1

# ------ AI 모델 ------
AI_MODEL_PATH=mtl_best.pth
AI_DEVICE=cpu
