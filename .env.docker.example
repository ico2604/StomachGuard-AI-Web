# ====================================================================
# Docker 환경 변수 템플릿 (.env.docker.example)
# docker-compose.yml / docker-compose.dev.yml 에서 사용
# ====================================================================
#
# 사용 방법:
#   cp .env.docker.example .env.docker
#   # SECRET_KEY, ENCRYPTION_KEY 를 실제 랜덤 값으로 변경
#
# 키 생성:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ====================================================================

# ------ JWT / 암호화 (필수 - 반드시 변경!) ------
# 아래 명령어로 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-THIS-generate-with-python-secrets-token-urlsafe-48-minimum-32-chars
ENCRYPTION_KEY=CHANGE-THIS-generate-with-python-secrets-token-urlsafe-32-min32chars

# ------ 데이터베이스 ------
# (docker-compose.yml에서 환경변수로 override 됨)
DATABASE_URL=postgresql+psycopg2://gastric:gastric_secret@postgres:5432/gastric_hospital

# ------ PostgreSQL ------
POSTGRES_USER=gastric
POSTGRES_PASSWORD=gastric_secret
POSTGRES_DB=gastric_hospital

# ------ JWT ------
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------ 서버 ------
ENVIRONMENT=production
DEBUG=False
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:80","http://localhost"]

# ------ Redis / Celery ------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ------ Dynamic Batching ------
BATCH_SIZE=8
BATCH_TIMEOUT_MS=100

# ------ Celery Worker ------
CELERY_WORKER_CONCURRENCY=1

# ------ AI 모델 ------
AI_MODEL_PATH=/app/models/mtl_best.pth
AI_DEVICE=cuda
